# Copy to .env.existing. See docs/EXISTING_ANGIE.md.
APM_PUBLIC_URL=https://apm.example.com
APM_COOKIE_SECURE=true
APM_DEFAULT_LANGUAGE=ru
APM_SAFE_APPLY=true
APM_SAFE_APPLY_TIMEOUT=120
APM_SAFE_APPLY_CHECKS=[]
APM_ANGIE_MODE=existing
# Must be the SAME absolute path on the host, in manager and in worker.
APM_DATA_DIR=/srv/apm
# Match the running Angie's binary, main config and prefix (-p / build --prefix).
APM_ANGIE_BINARY=/usr/sbin/angie
APM_ANGIE_CONFIG=/etc/angie/angie.conf
APM_ANGIE_PREFIX=/etc/angie
APM_ANGIE_STATUS_URL=http://127.0.0.1:18081/status/angie
APM_DISCOVERY_ENABLED=false
APM_DOCKER_URL=http://docker-gateway:2375
APM_DISCOVERY_NETWORKS=[]
APM_DISCOVERY_DOMAINS=[]
APM_DISCOVERY_ACME_TERMS_AGREED=false
APM_ACME_EMAIL=
APM_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
